{
  "name": "@pascal-app/plugin-landscape",
  "version": "0.1.0",
  "description": "Landscape design plugin for the Pascal editor.",
  "homepage": "https://editor.pascal.app/docs/developers/plugins",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "scripts/dev.ts",
    "!src/**/*.test.ts",
    "!src/**/*.test.tsx",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "check-types": "tsc --noEmit",
    "test": "bun test",
    "dev": "bun scripts/dev.ts",
    "dev:link": "bun scripts/dev.ts --link-only",
    "dev:unlink": "bun scripts/dev.ts --unlink"
  },
  "peerDependencies": {
    "@pascal-app/core": "^1.0.4",
    "react": "^18 || ^19",
    "@pascal-app/editor": "^1.0.4",
    "@pascal-app/viewer": "^1.0.4",
    "@react-three/fiber": "^9",
    "three": "^0.186.0",
    "zod": "^4.6.7",
    "@react-three/drei": "^10"
  },
  "devDependencies": {
    "@pascal-app/core": "1.0.4",
    "@pascal-app/editor": "1.0.4",
    "@pascal-app/viewer": "1.0.4",
    "@react-three/fiber": "^9",
    "@types/blob-stream": "^0.1.33",
    "@types/bun": "^1.3.5",
    "@types/howler": "^2.2.13",
    "@types/node": "^22.19.12",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19.2.2",
    "@types/three": "^0.184.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "three": "^0.186.0",
    "typescript": "6.0.3",
    "zod": "^4.6.7",
    "@types/react-dom": "^19.2.2",
    "@react-three/drei": "^10"
  },
  "keywords": [
    "pascal",
    "landscape",
    "plugin"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sudhir9297/landscape-pascal-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/sudhir9297/landscape-pascal-plugin/issues"
  },
  "dependencies": {
    "clipper-lib": "^6.4.2",
    "polygon-clipping": "^0.15.7",
    "@types/clipper-lib": "^6.4.0"
  }
}
